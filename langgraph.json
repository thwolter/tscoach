{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "graphs": {
    "agent": "./src/agent/graph.py:graph"
  },
  "auth": {
    "path": "./auth.py:my_auth"
  },
  "env": ".env",
  "image_distro": "wolfi",
  "http": {
    "configurable_headers": {
      "include": [
        "x-authenticated-user-id",
        "x-authenticated-user-email"
      ]
    }
  }
}
